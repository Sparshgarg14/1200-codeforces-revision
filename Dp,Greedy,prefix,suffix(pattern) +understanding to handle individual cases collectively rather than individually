    // 1. Parent Array -> Rooted Tree
    static List<List<Integer>> buildTree(int n, int[] parent) {

        List<List<Integer>> tree = new ArrayList<>();

        for (int i = 0; i <= n; i++) {
            tree.add(new ArrayList<>());
        }

        for (int i = 2; i <= n; i++) {
            tree.get(parent[i]).add(i);
        }

        return tree;
    }

    // 2. Edges -> Undirected Tree
    static List<List<Integer>> buildUndirectedTree(
            int n, int[][] edges) {

        List<List<Integer>> tree = new ArrayList<>();

        for (int i = 0; i <= n; i++) {
            tree.add(new ArrayList<>());
        }

        for (int[] edge : edges) {

            int u = edge[0];
            int v = edge[1];

            tree.get(u).add(v);
            tree.get(v).add(u);
        }

        return tree;
    }

    public static class Pair {
        public int a, b;
        Pair(int a, int b) {
            this.a = a;
            this.b = b;
        }
        @Override
        public String toString() {
            return a + " -> " + b;
        }
        @Override
        public boolean equals(Object o) {
            if (this == o) return true;
            if (o == null || getClass() != o.getClass()) return false;
            Pair that = (Pair) o;
            return a == that.a && b == that.b;
        }
    }
