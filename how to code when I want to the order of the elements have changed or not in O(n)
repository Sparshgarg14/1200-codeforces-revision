        public static int dfs(int node , List<List<Integer>>tree){
        if(tree.get(node).isEmpty()){
            ans++;
            return 1;
        }
        List<Integer>h  =new ArrayList<>();

        for(int child:tree.get(node)){
            h.add(dfs(child,tree));
